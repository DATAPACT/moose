# Moose configuration example.
# Admin API key (full access). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MOOSE_API_KEY=change_me
# External users get their own API token through an invitation (see Partners in the README).

# --- LLM gateway (LiteLLM) ---------------------------------------------------
# Provider keys (OpenRouter, Ollama, ...) are NOT configured here. Add them as models
# in the LiteLLM admin UI (see "LLM gateway" in the README).
#
# Virtual key that Moose uses to call the gateway. Create it in the LiteLLM UI
# (Virtual Keys) with a budget; leave its model list empty to allow every gateway model.
MOOSE_LLM_API_KEY=
# Default model (gateway name). Requests may pick another model allowed on the
# virtual key above; GET /models lists them.
MOOSE_MODEL=openai/gpt-oss-120b

# Gateway secrets. Generate random values, e.g. `openssl rand -hex 32`.
# The admin UI login is LITELLM_UI_USERNAME / LITELLM_UI_PASSWORD.
# LITELLM_MASTER_KEY must start with "sk-".
LITELLM_MASTER_KEY=sk-change_me
# Encrypts provider keys stored in the gateway database. Never change it after first start.
LITELLM_SALT_KEY=change_me
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change_me
LITELLM_DB_PASSWORD=change_me
# Loopback only: public access goes through Cloudflare, never a published port.
LITELLM_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000

# Host ports to avoid conflicts. Keep MOOSE_BIND_ADDRESS at 127.0.0.1 in production.
# Containers always listen on 8000 (API) and 8501 (Streamlit).
MOOSE_BIND_ADDRESS=127.0.0.1
MOOSE_API_PORT=8000
MOOSE_DEMO_PORT=8501

# Production: existing Docker network shared with your reverse proxy/tunnel.
MOOSE_PROXY_NETWORK=moose-proxy

MOOSE_TIMEOUT_SECS=300

# Queue storage (MongoDB)
# Use mongodb://mongo:27017 for docker-compose, or mongodb://localhost:27017 for local runs.
MOOSE_MONGO_URL=mongodb://mongo:27017
MOOSE_MONGO_DB=moose
# Where MongoDB keeps its data: a host folder (default ./data/mongo) or a named
# Docker volume. Use moose-mongo on macOS with Docker Desktop.
MOOSE_MONGO_VOLUME=

# Worker/queue settings
MOOSE_WORKER_COUNT=4
MOOSE_QUEUE_MAXSIZE=1000
MOOSE_MAX_RETRIES=2

# API web server settings
# Uvicorn process count. Keep 1: partner jobs run in the process that received them,
# because their gateway key is held only in that process's memory.
MOOSE_WEB_CONCURRENCY=1
