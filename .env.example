# Moose configuration example.
# Key for using the shared models; may be given to external users. It grants no
# administration (that needs a Keycloak account with MOOSE_OIDC_ADMIN_ROLE). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MOOSE_API_KEY=change_me
# External users get their own API token through an invitation (see Partners in the README).

# Encrypts the shared provider key (the operator's own key for shared models, set on
# the dashboard's Account page by an administrator). Random and long, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never change it after storing the key, or re-enter the key afterwards.
MOOSE_SECRET_KEY=change_me

# Host ports to avoid conflicts. Keep MOOSE_BIND_ADDRESS at 127.0.0.1 in production.
# Containers always listen on 8000 (API) and 8501 (Streamlit).
MOOSE_BIND_ADDRESS=127.0.0.1
MOOSE_API_PORT=8000
MOOSE_DEMO_PORT=8501

# Production: existing Docker network shared with your reverse proxy/tunnel.
MOOSE_PROXY_NETWORK=moose-proxy

MOOSE_TIMEOUT_SECS=300

# Queue storage (MongoDB)
# Use mongodb://mongo:27017 for docker-compose, or mongodb://localhost:27017 for local runs.
MOOSE_MONGO_URL=mongodb://mongo:27017
MOOSE_MONGO_DB=moose
# Where MongoDB keeps its data: a host folder (default ./data/mongo) or a named
# Docker volume. Use moose-mongo on macOS with Docker Desktop.
MOOSE_MONGO_VOLUME=

# Login. true (default): Keycloak, needed for administration and user vaults.
# false: no login, local development only (see "Login off" in the README).
MOOSE_AUTH_ENABLED=true
# Address users open the dashboard at, e.g. https://moose-ui.example.org or http://localhost:8501.
MOOSE_DASHBOARD_URL=

# Account login (Keycloak); see "Account login" in the README.
MOOSE_OIDC_ISSUER=
# Only if Moose must fetch Keycloak's signing keys from another URL (e.g. inside Docker).
MOOSE_OIDC_JWKS_URL=
MOOSE_OIDC_CLIENT_IDS=moose-dashboard
MOOSE_OIDC_USER_ROLE=moose-user
MOOSE_OIDC_ADMIN_ROLE=moose-admin
MOOSE_DASHBOARD_OIDC_METADATA_URL=
MOOSE_DASHBOARD_OIDC_CLIENT_ID=moose-dashboard
MOOSE_DASHBOARD_OIDC_CLIENT_SECRET=
MOOSE_DASHBOARD_COOKIE_SECRET=

# Worker/queue settings
MOOSE_WORKER_COUNT=4
MOOSE_QUEUE_MAXSIZE=1000
MOOSE_MAX_RETRIES=2

# API web server settings
# Uvicorn process count. Keep 1: jobs on users' own keys run in the process that
# received them, because those keys are held only in that process's memory.
MOOSE_WEB_CONCURRENCY=1
